#!/usr/bin/python3
"""List a page of contact cards from the BusyContacts 2026.4.4 store."""
import contextlib
import itertools
import json
from pathlib import Path
import plistlib
import re
import sqlite3
import sys
import unicodedata

sys.path.insert(0, str(Path(__file__).resolve().parent))
from card_details import archived_value


DATABASE = Path.home() / "Library/Group Containers/N4RA379GBW.com.busymac.busycontacts/Data/BusyContacts.bsql"
EMAIL, PHONE = 4, 18
# BusyContacts stores names as attributed strings. Decode only their text.
def title(blob):
    if not blob:
        return ""
    try:
        archive = plistlib.loads(blob)
        objects = archive["$objects"]
        root = objects[archive["$top"]["root"].data]
        value = objects[root["NSString"].data] if isinstance(root, dict) else root
        return value if isinstance(value, str) else ""
    except (ValueError, TypeError, AttributeError, IndexError, KeyError, OverflowError, plistlib.InvalidFileException):
        return ""


def card(rows, books):
    first = next(rows)
    name = title(first["title"]) or first["indexed_name"] or " ".join(
        part for part in (first["first"], first["middle"], first["last"]) if part)
    contact = {"id": first["id"], "name": name, "addressBook": books.get(first["book"], ""),
               "givenName": first["first"] or "", "familyName": first["last"] or "", "phones": [], "emails": []}
    contact["tags"] = tag_names(first["tags"])
    extra = {"fieldValue": [], "organization": [], "jobTitle": [], "address": [], "url": []}
    for row in itertools.chain([first], rows):
        if row["kind"] == 0 and row["attributes"]:
            extra["address"].extend(address_values(row["attributes"]))
        if row["value"]:
            values = {EMAIL: contact["emails"], PHONE: contact["phones"]}.get(row["kind"], extra["fieldValue"])
            if row["value"] not in values:
                values.append(row["value"])
            specific = {14: "organization", 19: "jobTitle", 21: "url"}.get(row["kind"])
            if specific:
                extra[specific].append(row["value"])
    return contact, extra, first


# ZFIELDDICT holds OpenStep plist string pairs for each address component.
ADDRESS_PAIR = re.compile(r'"(?:street|city|zip|state|country|countryCode|subLocality|subAdministrativeArea)"\s*=\s*"((?:\\.|[^"\\])*)"', re.S)
ESCAPE = re.compile(r'\\(?:U([\da-fA-F]{4})|(.))', re.S)


def address_values(attributes):
    def unescape(match):
        if match[1]:
            return chr(int(match[1], 16))
        return {"n": "\n", "r": "\r", "t": "\t"}.get(match[2], match[2])
    return [ESCAPE.sub(unescape, value) for value in ADDRESS_PAIR.findall(attributes)]


def fold(text):
    return unicodedata.normalize("NFC", text).casefold()


def tag_names(blob):
    tags = archived_value(blob)
    if tags is None:
        return []
    if isinstance(tags, str):
        return [tags]
    if not isinstance(tags, list) or not all(isinstance(name, str) for name in tags):
        raise ValueError("Unsupported BusyContacts tag archive")
    return tags


def assigned_tags(db, entity, books, address_book):
    counts = {}
    for blob, book in db.execute(
        "SELECT ZTAGS,ZPARENTCONTAINERDIRECT FROM ZCOMMONDATA WHERE Z_ENT=? AND ZTAGS IS NOT NULL ORDER BY Z_PK",
        (entity,)
    ):
        if address_book and fold(books.get(book, "")) != fold(address_book):
            continue
        seen = set()
        for name in tag_names(blob):
            key = fold(name)
            if key and key not in seen:
                seen.add(key)
                entry = counts.setdefault(key, {"name": name, "contacts": 0})
                entry["contacts"] += 1
    return {"tags": [counts[key] for key in sorted(counts)]}


def page(db, params):
    if not isinstance(params, dict) or params.keys() - {"query", "after", "limit", "tag", "addressBook", "field", "listTags"}:
        raise ValueError("Unknown search argument")
    after, limit, query = params.get("after", 0), params.get("limit", 50), params.get("query", "")
    if type(after) is not int or not 0 <= after < 2**63 or type(limit) is not int or not 1 <= limit <= 100:
        raise ValueError("Use a nonnegative after cursor and a limit between 1 and 100")
    if not isinstance(query, str):
        raise ValueError("query must be text")
    field = params.get("field", "all")
    if field not in {"all", "name", "email", "phone", "tag", "note", "fieldValue", "addressBook", "organization", "jobTitle", "address", "url"}:
        raise ValueError("Unsupported search field")
    if any(not isinstance(params[k], str) or not params[k].strip() for k in ("tag", "addressBook") if k in params):
        raise ValueError("Tag and address book must be nonempty strings")
    needle = fold(query.strip())
    digits = "".join(c for c in needle if c.isdecimal())
    number = digits if digits and all(c.isdecimal() or c in "+()- ./" for c in needle) else ""
    db.row_factory = sqlite3.Row
    entities = dict(db.execute("SELECT Z_NAME, Z_ENT FROM Z_PRIMARYKEY"))
    if not {"Book", "Contact", "FieldData"} <= entities.keys():
        raise ValueError("Unsupported BusyContacts database schema")
    books = {r[0]: title(r[1]) for r in db.execute(
        "SELECT Z_PK, ZTITLE FROM ZCOMMONDATA WHERE Z_ENT=?", (entities["Book"],))}
    if params.get("listTags"):
        return assigned_tags(db, entities["Contact"], books, params.get("addressBook"))
    rows = db.execute("""
        SELECT c.Z_PK AS id, c.ZFIRSTNAME AS first, c.ZMIDDLENAME AS middle, c.ZLASTNAME AS last,
               c.ZTITLE AS title, c.ZLOCALTITLESEARCHTEXT AS indexed_name, c.ZPARENTCONTAINERDIRECT AS book,
               c.ZTAGS AS tags, c.ZCONTENT AS note, c.ZLOCALSEARCHTEXT AS search_text,
               f.ZFIELDTYPE AS kind, f.ZFIELDSTRING AS value, f.ZFIELDDICT AS attributes
        FROM ZCOMMONDATA c LEFT JOIN ZEXTRADATA f ON f.ZPARENTOBJECT=c.Z_PK
             AND f.Z_ENT=?
        WHERE c.Z_ENT=? AND c.Z_PK>?
        ORDER BY c.Z_PK, f.ZFIELDSORT, f.Z_PK
        """, (entities["FieldData"], entities["Contact"], after))
    contacts = []
    for _, group in itertools.groupby(rows, key=lambda row: row["id"]):
        item, extra, first = card(group, books)
        if "addressBook" in params and fold(params["addressBook"]) != fold(item["addressBook"]):
            continue
        if "tag" in params and fold(params["tag"]) not in map(fold, item["tags"]):
            continue
        if needle:
            fields = {"name": [item["name"], item["givenName"], item["familyName"]],
                      "email": item["emails"], "phone": item["phones"], "tag": item["tags"],
                      "addressBook": [item["addressBook"]], **extra}
            if field in ("note", "all"):
                fields["note"] = [archived_value(first["note"]) or ""]
            values = ([first["search_text"] or "", *itertools.chain.from_iterable(fields.values())]
                      if field == "all" else fields[field])
            if not any(needle in fold(v) for v in values):
                if field not in ("all", "phone") or not number or not any(
                    number in "".join(c for c in phone if c.isdecimal()) for phone in item["phones"]
                ):
                    continue
        if len(contacts) == limit:
            return {"contacts": contacts, "nextAfter": contacts[-1]["id"]}
        contacts.append(item)
    return {"contacts": contacts, "nextAfter": None}


def read(database, params):
    with contextlib.closing(sqlite3.connect(database.as_uri() + "?mode=ro", uri=True, timeout=2)) as db:
        db.execute("PRAGMA query_only=ON")
        db.execute("BEGIN")
        return page(db, params)


if __name__ == "__main__":
    try:
        line = sys.stdin.buffer.readline(65537)
        if len(line) > 65536:
            raise ValueError("Request exceeds 64 KiB")
        response = {"result": read(DATABASE, json.loads(line))}
    except (sqlite3.Error, ValueError, OSError) as exc:
        detail = str(exc)
        if "authorization denied" in detail or isinstance(exc, PermissionError):
            detail = "macOS denied access to BusyContacts app data. Allow iMCP Next to read this app’s data in Privacy & Security."
        response = {"error": {"message": f"Cannot read BusyContacts: {detail}"}}
    print(json.dumps(response, ensure_ascii=False))
