#!/usr/bin/python3
"""Forward one iMCP request to imsg rpc. Installed by the user on the host Mac."""
import selectors
import subprocess
import time
import json
import os
from pathlib import Path
import re
import signal
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
import imsg_operations

MAX_REQUEST = 64 * 1024
MAX_RESPONSE = 8 * 1024 * 1024
METHODS = {
    "status": set(),
    "chats.list": {"limit", "unread_only"},
    "messages.history": {"chat_id", "participants", "start", "end", "limit", "attachments"},
    "messages.search": {"query", "match", "limit"},
    "send": {"to", "chat_id", "chat_guid", "chat_identifier", "text", "file", "service", "region", "allow_sms_fallback"},
}


def validate(request):
    method = request["method"]
    params = request["params"]
    if method not in METHODS or not isinstance(params, dict) or params.keys() - METHODS[method]:
        raise ValueError("Unsupported imsg method or parameter")
    for key, value in params.items():
        if key in {"limit", "chat_id"}:
            valid = type(value) is int and value > 0 and (key != "limit" or value <= 100)
        elif key in {"attachments", "unread_only", "allow_sms_fallback"}:
            valid = isinstance(value, bool)
        elif key == "participants":
            valid = isinstance(value, list) and all(isinstance(item, str) for item in value)
        else:
            valid = isinstance(value, str) and bool(value.strip())
        if not valid:
            raise ValueError(f"Invalid {key}")
    if method == "messages.history" and "chat_id" not in params:
        raise ValueError("History requires chat_id")
    if method == "messages.search" and "query" not in params:
        raise ValueError("Search requires query")
    if method == "send":
        if not ({"text", "file"} & params.keys()) or len({"to", "chat_id", "chat_guid", "chat_identifier"} & params.keys()) != 1:
            raise ValueError("Provide text or file and exactly one recipient or chat selector")
        if "service" in params and ("to" not in params or params["service"] not in {"auto", "imessage", "sms"}):
            raise ValueError("service requires a direct recipient and must be auto, imessage, or sms")
    return {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}


def command(mode, target, method):
    if mode in {"imsg-vm", "lume"}:  # Older app builds pass "lume".
        action = "imsg" if method == "send" else "imsg-ro"
        return [str(Path.home() / ".local/bin/imsg-vm"), action, "rpc"]
    if mode == "local":
        candidates = ([Path(target).expanduser()] if target else
                      [Path("/opt/homebrew/bin/imsg"), Path("/usr/local/bin/imsg")])
        for path in candidates:
            if path.is_absolute() and path.name == "imsg" and path.is_file() and os.access(path, os.X_OK):
                return [str(path), "rpc"]
        raise ValueError("Set the absolute path to the imsg executable on this Mac in Settings > Messages.")
    host = target
    if mode != "ssh" or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,252}", host):
        raise ValueError("Enter a Host alias from ~/.ssh/config")
    return ["/usr/bin/ssh", "-T", "-oBatchMode=yes", "-oStrictHostKeyChecking=yes",
            "-oIdentitiesOnly=yes", "-oConnectTimeout=8", "--", host, "/usr/local/bin/imsg rpc"]


def capture(argv, data, timeout=45, maximum=MAX_RESPONSE, window=False, hold_input=False):
    # Keep all three pipes moving. SSH and the wrapper can both have descendants
    # holding a pipe open, even after the immediate child has exited.
    payload = memoryview(data)
    stdout, stderr = bytearray(), bytearray()
    deadline = time.monotonic() + timeout
    with subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, start_new_session=True) as proc:
        try:
            with selectors.DefaultSelector() as selector:
                for stream in (proc.stdin, proc.stdout, proc.stderr):
                    os.set_blocking(stream.fileno(), False)
                    selector.register(stream, selectors.EVENT_WRITE if stream is proc.stdin else selectors.EVENT_READ)
                while selector.get_map():
                    events = selector.select(max(0, deadline - time.monotonic()))
                    if not events or time.monotonic() >= deadline:
                        if window:
                            os.killpg(proc.pid, signal.SIGKILL)
                            proc.wait()
                            # Only return complete JSON lines emitted within the window.
                            return bytes(stdout[:stdout.rfind(b"\n") + 1])
                        raise TimeoutError()
                    for key, _ in events:
                        if key.fileobj is proc.stdin:
                            try:
                                payload = payload[os.write(key.fd, payload):]
                            except BrokenPipeError:
                                payload = b""
                            if not payload:
                                selector.unregister(proc.stdin)
                                if not hold_input:
                                    proc.stdin.close()
                        else:
                            chunk = os.read(key.fd, 65536)
                            if not chunk:
                                selector.unregister(key.fd)
                                continue
                            buffer = stdout if key.fileobj is proc.stdout else stderr
                            buffer.extend(chunk)
                            if len(buffer) > (maximum if buffer is stdout else 65536):
                                raise ValueError("imsg output exceeded the size limit. Request fewer rows.")
            status = proc.wait(timeout=max(0, deadline - time.monotonic()))
        except BaseException:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            raise
    if status != 0:
        detail = stderr.decode(errors="replace").strip()[-800:]
        raise ValueError(detail or f"imsg exited with status {status}")
    return bytes(stdout)


def exchange(argv, request, timeout=45):
    reply = json.loads(capture(argv, json.dumps(request).encode() + b"\n", timeout))
    if reply.get("jsonrpc") != "2.0" or type(reply.get("id")) is not int or reply["id"] != 1:
        raise ValueError("Unexpected imsg RPC response")
    if "error" in reply:
        return {"error": reply["error"]}
    return {"result": reply["result"]}


def main():
    try:
        mode, host = sys.argv[1:]
        line = sys.stdin.buffer.readline(MAX_REQUEST + 1)
        if len(line) > MAX_REQUEST:
            raise ValueError("Request exceeds 64 KiB")
        raw = json.loads(line)
        if raw["method"].startswith("catalog."):
            reply = imsg_operations.execute(raw["method"][8:], raw["params"], mode, host, command, exchange, capture)
        else:
            request = validate(raw)
            reply = exchange(command(mode, host, request["method"]), request)
    except (TimeoutError, subprocess.TimeoutExpired):
        reply = {"error": {"message": "imsg timed out. For a send, check history before retrying."}}
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as exc:
        reply = {"error": {"message": str(exc)}}
    print(json.dumps(reply, ensure_ascii=False))


if __name__ == "__main__":
    main()
